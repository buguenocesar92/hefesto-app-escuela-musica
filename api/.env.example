# ---------------------------------------------------------------------------
# Variables de entorno de la API (Laravel)
# ---------------------------------------------------------------------------
#
# NINGÚN valor de este archivo es real. Todos son de ejemplo.
#
# Copiar a `.env` y cambiar lo que corresponda:
#   Linux:  cp .env.example .env
#
# Las variables de la interfaz (web/.env.example) están aparte: son otro
# contenedor y no comparten este archivo.
#
# LO QUE ESTÁ EN BLANCO ES UNA DECISIÓN PENDIENTE DEL CLIENTE, no un error de
# configuración. Están en blanco porque el sistema no las deduce: ver la
# sección final de este archivo y docs/05-CONFIGURACION.md.
# ---------------------------------------------------------------------------

# --- Aplicación -----------------------------------------------------------
APP_NOMBRE="Escuela de Música y Arte"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Santiago
# La interfaz sirve la aplicación. En producción debe ser el dominio real.
APP_URL=http://localhost:8080

# --- Registro -------------------------------------------------------------
LOG_CHANNEL=stack
LOG_LEVEL=info
LOG_DAYS=14

# --- Base de datos --------------------------------------------------------
# PostgreSQL es obligatorio: el aislamiento entre escuelas depende de Row
# Level Security, que no existe en otros motores.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=escuela_musica
DB_USERNAME=escuela_musica_app
DB_PASSWORD=cambiar

# ---------------------------------------------------------------------------
# Rol de arranque de PostgreSQL
# ---------------------------------------------------------------------------
# El rol de arriba es el de la APLICACION. Este es el de arranque: la imagen
# oficial lo crea como superusuario, asi que la aplicacion NUNCA conecta con el.
# Con superusuario, PostgreSQL ignora las politicas de Row Level Security y una
# empresa podria ver los datos de otra. Los dos detalles, en docs/03.
DB_ADMIN_USERNAME=escuela_musica_admin
DB_ADMIN_PASSWORD=

DB_SSLMODE=prefer

# --- Sesión ---------------------------------------------------------------
# El nombre del dominio se completa en producción con APP_URL.
SESSION_DRIVER=file
SESSION_LIFETIME=480
SESSION_COOKIE=escuela_musica_sesion
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# --- Caché y cola ---------------------------------------------------------
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# --- Redis ----------------------------------------------------------------
# Redis guarda caché y cola. No es fuente de verdad.
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=escuela_musica_db_

# --- Identidad (Authentik) ------------------------------------------------
# El login lo resuelve Authentik. Aquí NO hay contraseñas de usuarios.
AUTHENTIK_BASE_URL=http://localhost:8443/application/o/escuela-musica/
AUTHENTIK_ISSUER=http://localhost:8443/application/o/escuela-musica/
AUTHENTIK_CLIENT_ID=cambiar
AUTHENTIK_CLIENT_SECRET=cambiar
# Debe coincidir EXACTAMENTE con la ruta registrada en Authentik y con la ruta
# /api/v1/auth/callback de routes/web.php. Si no coinciden, el proveedor rechaza
# la petición y el ingreso no funciona.
AUTHENTIK_REDIRECT_URI=http://localhost:8080/api/v1/auth/callback
AUTHENTIK_SCOPE="openid profile email"
# No apagar en producción: sin verificación de firma, cualquiera que llegue al
# callback podría presentar un token hecho a mano.
AUTHENTIK_VERIFICAR_FIRMA=true
AUTHENTIK_VERIFICAR_CERTIFICATO=true
AUTHENTIK_TOLERANCIA_RELOJ=60
AUTHENTIK_HTTP_TIMEOUT=10

# ---Reglas de negocio que la escuela decide -------------------------------
# Estas tres NO tienen valor por omisión a propósito. Ver el comentario de cada
# una en docs/05-CONFIGURACION.md.
#
# 1. ¿Una ausencia consume la clase del plan? Valores: si | no
#    Si queda vacío, la ausencia se registra pero queda marcada como "por
#    definir" y NO se consume ninguna clase. El sistema no adivina.
ESCUELA_MUSICA_ABSENCIA_CONSUME_PLAN=

# 2. ¿Cuántos días vive una clase recuperada antes de caducar? Entero.
#    Si queda vacío, la recuperación NO caduca y la deuda se acumula. En ese
#    caso la deuda se muestra aparte en el tablero para que no pase inadvertida.
ESCUELA_MUSICA_DIAS_RECUPERACION=

# 3. ¿Con cuántos días de anticipación se avisa de un plan por vencer? Entero.
#    Si queda vacío no hay aviso, pero la lista de morosos se sigue viendo
#    completa.
ESCUELA_MUSICA_DIAS_AVISO_MOROSIDAD=

# --- Otros valores configurables -------------------------------------------
# Roles que pueden ver los pagos de los alumnos.
ESCUELA_MUSICA_ROLES_QUE_VEN_PAGOS=direccion,administracion
# Obligatoriedad de la autorización del adulto responsable para alumnos
# menores de edad. El valor `true` es la postura segura; bajarlo a `false` es
# decisión consciente de la escuela y queda en el registro.
ESCUELA_MUSICA_EXIGIR_AUTORIZACION=true
# Retención de la bitácora de accesos, en horas. 8760 es un año.
ESCUELA_MUSICA_RETENCION_BITACORA_HORAS=8760
# Tope de filas por página en los listados.
ESCUELA_MUSICA_POR_PAGINA_MAXIMO=100