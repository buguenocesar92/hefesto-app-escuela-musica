# ---------------------------------------------------------------------------
# Variables que usa el despliegue con Docker Compose
# ---------------------------------------------------------------------------
#
# NINGÚN valor de este archivo es real. Todos son de ejemplo o están vacíos.
#
# Este archivo lo lee `deploy/docker-compose.prod.yml`, que se ejecuta desde
# `deploy/`. Los archivos de la API y de la interfaz van aparte:
#
#   api/.env.example   para trabajar la API fuera de Docker
#   web/.env.example   para trabajar la interfaz fuera de Docker
#
# Para producción se copia a `.env.prod`:
#
#   cp .env.example .env.prod
#
# El archivo `.env.prod` NO se versiona: ver `.gitignore`.
# ---------------------------------------------------------------------------

# --- Aplicación ----------------------------------------------------------
# Sin APP_KEY no hay sesión y nadie puede entrar. Se genera con:
#   docker compose -f deploy/docker-compose.prod.yml run --rm api php artisan key:generate
APP_KEY=

# Sin dominio no hay proxy: no hay certificado y no hay por dónde entrar.
# Es el dominio real de la escuela, no uno de ejemplo.
DOMINIO=

# Correo para los avisos de caducidad del certificado TLS. Sin esto, nadie se
# entera de que el certificado está por vencer, que es exactamente cuando
# importa enterarse.
ACME_CORREO=

# --- Registro de imágenes ------------------------------------------------
REGISTRO=hefestostudio
VERSION=ultima

# --- Base de datos -------------------------------------------------------
DB_DATABASE=escuela_musica

# El rol de la aplicación NO puede ser superusuario ni tener BYPASSRLS, o la
# Row Level Security se ignora y una escuela ve los datos de todas las demás.
DB_USERNAME=escuela_musica_app
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Rol de arranque de PostgreSQL
# ---------------------------------------------------------------------------
# El rol de arriba es el de la APLICACION. Este es el de arranque: la imagen
# oficial lo crea como superusuario, asi que la aplicacion NUNCA conecta con el.
# Con superusuario, PostgreSQL ignora las politicas de Row Level Security y una
# empresa podria ver los datos de otra. Los dos detalles, en docs/03.
DB_ADMIN_USERNAME=escuela_musica_admin
DB_ADMIN_PASSWORD=

# --- Identidad (Authentik) -----------------------------------------------
AUTHENTIK_BASE_URL=
AUTHENTIK_ISSUER=
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=

# Debe coincidir EXACTAMENTE con la ruta /auth/callback de la API y con lo
# registrado en Authentik. Si no coinciden, el proveedor rechaza la petición.
AUTHENTIK_REDIRECT_URI=

# --- Reglas de negocio que la escuela decide ------------------------------
# Las tres vienen vacías a propósito. Ver docs/05-CONFIGURACION.md.
#
# ¿Una ausencia consume la clase del plan? Valores: si | no
ESCUELA_MUSICA_ABSENCIA_CONSUME_PLAN=

# ¿Cuántos días vive una clase recuperada? Entero.
# Vacío = no caduca nunca, y la deuda aparece a la vista para revisarla a mano.
ESCUELA_MUSICA_DIAS_RECUPERACION=

# ¿Con cuántos días de anticipación se avisa de un plan por vencer? Entero.
ESCUELA_MUSICA_DIAS_AVISO_MOROSIDAD=

# --- Otros valores configurables -------------------------------------------
# Roles que pueden ver los pagos de los alumnos.
ESCUELA_MUSICA_ROLES_QUE_VEN_PAGOS=direccion,administracion

# Obligatoriedad de la autorización del adulto responsable para menores.
# true es la postura segura. Bajarlo a false es decisión consciente de la
# escuela.
ESCUELA_MUSICA_EXIGIR_AUTORIZACION=true

# Retención de la bitácora de accesos, en horas. 8760 es un año.
ESCUELA_MUSICA_RETENCION_BITACORA_HORAS=8760